# データベース接続設定
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# 読み取り専用モード（必ず true にすること）
DB_READ_ONLY=true

# 接続プール設定
DB_POOL_MIN=1
DB_POOL_MAX=5

# タイムアウト設定（秒）
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=30

# 店舗WebDB接続情報
# stores.domain/portで各店舗WebDBに接続する際の認証情報
STORE_DB_USER=readonly_user
STORE_DB_PASSWORD=
STORE_DB_NAME=smartparkdb_phase3
